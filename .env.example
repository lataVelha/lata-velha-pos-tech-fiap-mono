# Copie para .env (não versionado) e preencha. docker compose lê o .env da raiz
# automaticamente. Tudo aqui é opcional — sem preencher, o ambiente sobe do
# mesmo jeito (e-mail e Mercado Pago ficam só "best-effort"/desligados).

# E-mail (os-service e inventory-service) — Senha de App do Google, não a senha normal
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# inventory-service: quem recebe o aviso de "peça em falta, precisa encomendar"
NOTIFICACOES_ADMIN_EMAILS=admin@latavelha.com

# Mercado Pago (billing-service) — ver billing-service/.env.example para detalhes.
# Use SEMPRE as credenciais de TESTE (TEST-...) localmente.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_NOTIFICATION_URL=
MERCADOPAGO_BACK_URL_SUCCESS=
MERCADOPAGO_BACK_URL_FAILURE=
MERCADOPAGO_BACK_URL_PENDING=
